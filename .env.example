# ==============================================================================
# SPLENDER JEWEL — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Note: In Phase 0, Supabase is not yet configured. The application runs with
# safe development fallbacks and does not crash when these are empty.
# ==============================================================================

# Supabase Public Configuration (Safe for browser / client-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Private Configuration (CRITICAL: SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store Contact Defaults (Configurable via Admin Panel in production database)
NEXT_PUBLIC_DEFAULT_WHATSAPP_NUMBER=+94764689907
